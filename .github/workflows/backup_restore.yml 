name: backup_restore

on: workflow_dispatch

jobs:
  solve:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:16
        env:
          POSTGRES_PASSWORD: pg
          POSTGRES_USER: postgres
        ports: ["5432:5432"]
        options: >-
          --health-cmd "pg_isready -U postgres"
          --health-interval 2s
          --health-timeout 2s
          --health-retries 30
    env:
      HACKATTIC_TOKEN: ${{ secrets.HACKATTIC_TOKEN }}
    steps:
      - uses: actions/checkout@v4
      - name: Install deps
        run: |
          sudo apt-get update
          sudo apt-get install -y jq postgresql-client
      - name: Solve challenge
        run: |
          chmod +x ./solve.sh
          ./solve.sh